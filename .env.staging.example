# Safe configuration example only. Do not store actual secrets in this file.
# For staging: copy only reviewed, NONSECRET settings to a private .env.staging.local.
# Pass signing keys and LiveKit credentials through the secure process environment.
VVS_RUNTIME_PROFILE=staging
VVS_STAGING_CREDENTIALS_CONFIRMED=no
DENTAL_DEMO_MODE=yes
DENTAL_BOOKINGS_ENABLED=no
HQ_TELEMETRY_PRODUCER_ENABLED=no
# Set only after explicit approval in a secure shell:
# HQ_TELEMETRY_BUSINESS_ID=
# HQ_TELEMETRY_WORKER_ID=
# HQ_TELEMETRY_SIGNING_SECRET=
# HQ_TELEMETRY_ENDPOINT=http://127.0.0.1:18788/api/internal/telemetry
# HQ_TELEMETRY_OUTBOX_PATH=C:\\VVS-Private-Staging\\telemetry.sqlite

# Dedicated staging worker health endpoint; never reuse existing worker port 8081.
STAGING_NATIVE_HEALTH_URL=http://127.0.0.1:18081/
# After a separately approved staging worker launches, inspect its actual PID:
# STAGING_NATIVE_HEALTH_EXPECTED_PID=<Windows OS PID of approved node worker>
# Separately reviewed staging LiveKit URL must exactly match LIVEKIT_URL at launch:
# STAGING_LIVEKIT_URL=wss://your-dedicated-staging-livekit-project
# LIVEKIT_URL and its credentials must be provided through the private launch environment.
# Staging telemetry requires HQ local port other than 8787 or 8081.
