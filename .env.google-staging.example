# Safe browser-only synthetic Calendar tests in the isolated VVS Smilez Pilot project.
# No Google or LiveKit credentials here. Those remain in .env.google-pilot.local.
VVS_STAGING_APPROVED=yes
VVS_STAGING_BROWSER_ONLY=yes
VVS_STAGING_ALLOW_WRITES=no
VVS_STAGING_HEALTH_PORT=18084
VVS_STAGING_AUDIT_DIR=C:\\absolute\\private\\path\\outside-repo
